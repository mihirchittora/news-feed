# Required application settings (replace every placeholder outside local development)
DATABASE_URL=jdbc:postgresql://localhost:5440/news_platform
DATABASE_USERNAME=news_platform
DATABASE_PASSWORD=news_platform_dev
APP_ENVIRONMENT=development
POSTGRES_DB=news_platform
POSTGRES_PORT=5440
BACKEND_PORT=8080
WEB_PORT=3000

# Required in shared/production environments; this value is a local placeholder only.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION=3600
MAX_UPLOAD_REQUEST_SIZE=115343360
SPRING_PROFILES_ACTIVE=dev

# Required: comma-separated explicit frontend origins. Never use '*'.
FRONTEND_URL=http://localhost:3000
SECURITY_HSTS_ENABLED=false
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Development-only convenience bootstrap. Leave blank in production unless the secure
# deployment bootstrap procedure explicitly supplies a one-time administrator password.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe123!
INITIAL_ADMIN_NAME=Platform Admin

# Required for the browser build; use the public HTTPS URLs in production.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Used by the Next.js server and generated runtime-config.js inside the web container.
INTERNAL_API_URL=http://backend:8080
SITE_URL=http://localhost:3000
FEED_AD_INTERVAL=5

# Optional local storage settings. Production should point the existing storage abstraction
# at the approved persistent/object-storage adapter.
MEDIA_STORAGE_TYPE=local
MEDIA_STORAGE_PATH=./data/media
MEDIA_PUBLIC_URL=http://localhost:8080
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_MIN_IDLE=2
MAX_IMAGE_UPLOAD_SIZE=10485760
MAX_VIDEO_UPLOAD_SIZE=52428800
COMMENT_MAX_LENGTH=2000
SHUTDOWN_TIMEOUT=20s
BREAKING_NEWS_DEFAULT_DURATION_MINUTES=120
APP_TIMEZONE=Asia/Kolkata
AD_EXPIRING_SOON_HOURS=24
MAX_NEWSPAPER_PDF_UPLOAD_SIZE=104857600

# OCI-only runtime settings. Keep OCI storage disabled for local Compose development.
# OCI_REGION=
# OCI_OBJECT_STORAGE_NAMESPACE=
# OCI_OBJECT_STORAGE_BUCKET=
# OCI_VAULT_SECRET_DATABASE_PASSWORD_OCID=
# OCI_VAULT_SECRET_JWT_SECRET_OCID=
# OCI_VAULT_SECRET_INITIAL_ADMIN_PASSWORD_OCID=
