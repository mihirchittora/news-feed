# PostgreSQL / Spring Boot
DATABASE_URL=jdbc:postgresql://localhost:5440/news_platform
DATABASE_USERNAME=news_platform
DATABASE_PASSWORD=news_platform_dev
POSTGRES_DB=news_platform
POSTGRES_PORT=5440
BACKEND_PORT=8080
WEB_PORT=3000

# Use a long random value in every shared or deployed environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION=3600

# Comma-separated frontend origins accepted by the API.
FRONTEND_URL=http://localhost:3000

# Optional development-only first admin bootstrap.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe123!
INITIAL_ADMIN_NAME=Platform Admin

# Next.js browser API origin
NEXT_PUBLIC_API_URL=http://localhost:8080

# Local development media storage. Docker overrides the path to its named volume.
MEDIA_STORAGE_TYPE=local
MEDIA_STORAGE_PATH=./data/media
MEDIA_PUBLIC_URL=http://localhost:8080
MAX_IMAGE_UPLOAD_SIZE=10485760
MAX_VIDEO_UPLOAD_SIZE=52428800
BREAKING_NEWS_DEFAULT_DURATION_MINUTES=120
MAX_NEWSPAPER_PDF_UPLOAD_SIZE=104857600
